/**index.wxss**/
page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 用户信息栏 */
.user-header {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.score {
  font-size: 28rpx;
  color: #13A5F0;
  font-weight: 500;
}

.login-section {
  text-align: center;
}

.login-btn {
  background: #13A5F0;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  border: none;
  font-size: 28rpx;
}

/* 人参识别区域 */
.recognition-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

@media screen and (min-width: 768rpx) {
  .recognition-section {
    flex-direction: row;
    align-items: flex-start;
  }
  
  .upload-area-container,
  .result-area-container {
    flex: 1;
  }
  
  .upload-area-container {
    margin-right: 20rpx;
  }
  
  .result-area-container {
    margin-left: 20rpx;
  }
}

.section-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.upload-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.upload-subtitle {
  font-size: 24rpx;
  color: #666;
}

/* 上传区域 */
.upload-area {
  border: 4rpx dashed #ddd;
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #666;
}

.uploaded-image-container {
  text-align: center;
}

.uploaded-image {
  width: 100%;
  max-height: 300rpx;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.reupload-btn {
  background: #fff;
  color: #13A5F0;
  border: 2rpx solid #13A5F0;
  border-radius: 50rpx;
  padding: 12rpx 30rpx;
  font-size: 24rpx;
}

/* 结果区域 */
.result-area-container {
  min-height: 300rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.result-card {
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.result-item {
  display: flex;
  margin-bottom: 15rpx;
  align-items: center;
}

.result-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
}

.result-value {
  font-size: 26rpx;
  font-weight: bold;
  flex: 1;
}

.result-value.type {
  color: #13A5F0;
}

.result-value.age {
  color: #52C41A;
}

.result-value.confidence {
  color: #FA8C16;
}

.result-description {
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #eee;
}

.description-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.reanalyze-btn {
  background: #13A5F0;
  color: white;
  border-radius: 50rpx;
  padding: 15rpx;
  width: 100%;
  border: none;
  font-size: 26rpx;
}

/* 分析中状态 */
.analyzing {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.loading-icon {
  font-size: 50rpx;
  margin-bottom: 15rpx;
  animation: rotate 2s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
